# OpenAI credentials belong only in a local .env file or deployment secret store.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Persistent local state
CHROMA_PATH=.data/chroma
DATABASE_URL=sqlite:///.data/faq_chatbot.sqlite3

# Retrieval and session behavior
TOP_K=4
SIMILARITY_THRESHOLD=0.35
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
